# Auto Stitch Backend Environment Configuration Template
# Copy this file to .env and insert your secure API keys and credentials.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/autostitch?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# AI & LLM Integrations
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
VTON_SERVICE_URL=

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Email Dispatcher (SMTP / Gmail App Password)
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_app_password_here
