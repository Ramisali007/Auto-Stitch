# Auto Stitch Backend Environment Configuration Template
# Copy this file to .env and insert your secure API keys and credentials.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/autostitch?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Self-Hosted & Production Virtual Try-On (VTO) Configuration
VTO_ENABLED=true
VTO_MODEL=fashn-vton-1.5
VTO_MODEL_VERSION=1.5.0
VTO_DEVICE=cuda
VTO_DTYPE=fp16
VTO_TIMEOUT_SECONDS=90
VTO_UPLOAD_EXPIRY_SECONDS=900
VTO_RESULT_EXPIRY_SECONDS=3600
VTO_MAX_RETRIES=2
VTO_CONCURRENT_JOBS=2
VTO_WORKER_URL=http://localhost:8000

# AWS S3 Storage for VTO (Optional: Falls back to isolated encrypted local private storage if omitted)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_VTO_BUCKET=autostitch-vto-private
AWS_S3_VTO_PREFIX=vto/temp/

# Free Google Colab / GPU Service Fallback (Optional)
VTON_SERVICE_URL=

# AI & LLM Integrations (Chatbot & Personal Stylist)
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Email Dispatcher (SMTP / Gmail App Password)
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_app_password_here
